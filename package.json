{
  "name": "cocineria-mary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --config wrangler.worker.jsonc --ip 127.0.0.1 --port 8787",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply mary --config wrangler.worker.jsonc --local",
    "db:seed": "node scripts/seed.mjs",
    "setup": "npm run db:migrate && npm run db:seed",
    "admin:create": "node scripts/create-admin.mjs",
    "deploy:api": "wrangler deploy --config wrangler.worker.jsonc --env production"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "hono": "^4.9.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.2",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "miniflare": "5.20260923.0-alpha",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.33.0"
  }
}
